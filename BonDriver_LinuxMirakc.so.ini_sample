[GLOBAL]
SERVER_HOST="127.0.0.1"
SERVER_PORT=40772

SERVER_SOCKPATH="/var/run/mirakc.sock"

; "http" or "unix"
SERVER_TYPE="http"

; B25(1=enable)
DECODE_B25=1

; Priority(0=Low Priority)
PRIORITY=10

; Service Split(1=enable)
SERVICE_SPLIT=0


; Stream idle timeout in seconds. If no data arrives for this long after the
; stream has started, the receive thread stops and logs the error (default 10, 0=disable)
STREAM_TIMEOUT=10

; The ini path can also be given by the environment variable BONDRIVER_MIRAKC_INI
; (falls back to "<this .so path>.ini" when the file cannot be read).
