[GLOBAL]
SERVER_HOST="127.0.0.1"
SERVER_PORT=40772

SERVER_SOCKPATH="/var/run/mirakc.sock"

; "http" or "unix"
SERVER_TYPE="http"

; B25(1=enable)
DECODE_B25=1

; Priority(0=Low Priority)
PRIORITY=10

; Service Split(1=enable)
SERVICE_SPLIT=0

; Ring buffer size in bytes (default 134217728 = 128MB, range 65536 - 1073741824)
; Increase it for high-bitrate (4K) streams or when the host reads slowly.
; BUFFER_SIZE=134217728
